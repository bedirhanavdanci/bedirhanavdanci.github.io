/*-- scss:defaults --*/

/* ---------- Palette ---------- */

$paper-bg: #F2F5F7;
$text-main: #252A2D;
$text-muted: #687176;
$accent-color: #3D6670;
$border-color: #DCE3E7;


/*-- scss:rules --*/

/* ---------- Global ---------- */

body {
  background-color: $paper-bg;
  color: $text-main;
  font-family: "Charter", Georgia, serif;
  font-size: 17px;
  line-height: 1.7;
}

main {
  background-color: $paper-bg;
}

a {
  color: $accent-color;
  text-decoration: none;
}

a:hover {
  color: $text-main;
}


/* ---------- Navbar ---------- */

.navbar {
  background-color: $paper-bg !important;
  border-bottom: 1px solid #D9E2E0;
  box-shadow: none !important;
  padding-top: 0.85rem;
  padding-bottom: 0.85rem;
}

/* Center the entire navbar content */
.navbar .container-fluid,
.navbar .container {
  justify-content: center !important;
}

/* Site name */
.navbar-brand {
  display: block !important;
  color: #3A5F5B !important;
  font-family: "Charter", Georgia, serif;
  font-size: 1.05rem;
  font-weight: 500;
  margin-right: 1.5rem;
}

/* Navigation */
.navbar-collapse {
  flex-grow: 0 !important;
}

.navbar-nav {
  justify-content: center !important;
  align-items: center;
}

.navbar-nav .nav-link {
  color: #3A5F5B !important;
  font-family: "Charter", Georgia, serif;
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-transform: none;
  padding-left: 1rem;
  padding-right: 1rem;
}

.navbar-nav .nav-link:hover,
.navbar-nav .nav-link.active {
  color: #1F3D3A !important;
}

/* ---------- Homepage container ---------- */

#quarto-content {
  max-width: 900px;
  margin: 0 auto;
  padding-left: 2rem;
  padding-right: 2rem;
}


/* ---------- Homepage introduction ---------- */

.home-intro {
  max-width: 760px;
  margin: 5rem auto 0 auto;
  text-align: center;
}


/* ---------- Portrait ---------- */

.home-intro img {
  width: 165px;
  height: 165px;
  object-fit: cover;
  border-radius: 50%;
  display: block;
  margin: 0 auto 2rem auto;
}


/* ---------- Name ---------- */

.home-intro h1 {
  color: $text-main;
  font-family: "Charter", Georgia, serif;
  font-size: 2.45rem;
  font-weight: 500;
  line-height: 1.2;
  margin: 0 0 0.75rem 0;
}


/* ---------- Academic position ---------- */

.home-intro .position {
  color: $accent-color;
  font-size: 1.15rem;
  line-height: 1.5;
  margin: 0 auto 0.35rem auto;
  font-weight: 500;
}


/* ---------- Institution ---------- */

.home-intro .institution {
  font-size: 1rem;
  line-height: 1.5;
  margin: 0 auto 1.8rem auto;
}

.home-intro .institution a {
  color: #0066CC !important;
  text-decoration: none !important;
}

.home-intro .institution a:hover {
  color: #004C99 !important;
  text-decoration: underline !important;
}


/* ---------- Research statement ---------- */

.home-intro .research {
  max-width: 680px;
  margin: 0 auto;
  color: $text-main;
  font-size: 1.05rem;
  line-height: 1.75;
}


/* ---------- Social links ---------- */

.social-links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1.15rem;
  margin-top: 2rem;
}

.social-links a {
  color: $text-muted;
  transition: color 0.2s ease;
}

.social-links a:hover {
  color: $accent-color;
}

.social-links svg {
  width: 20px;
  height: 20px;
  fill: currentColor;
}


/* ---------- General headings ---------- */

h1,
h2,
h3,
h4 {
  color: $text-main;
  font-family: "Charter", Georgia, serif;
  font-weight: 500;
}

h2 {
  margin-top: 3.5rem;
  margin-bottom: 1.25rem;
  font-size: 1.7rem;
}

h3 {
  font-size: 1.35rem;
}


/* ---------- General text ---------- */

p {
  color: $text-main;
}

.quarto-title-block {
  margin-bottom: 0;
}


/* ---------- Remove old process-flow graphics ---------- */

.process-flow,
.process-flow-container,
.process-image,
.process-images,
.ecology-process {
  display: none !important;
}


/* ---------- Mobile ---------- */

@media (max-width: 768px) {

  #quarto-content {
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .home-intro {
    margin-top: 3.5rem;
  }

  .home-intro img {
    width: 140px;
    height: 140px;
    margin-bottom: 1.6rem;
  }

  .home-intro h1 {
    font-size: 2rem;
  }

  .home-intro .position {
    font-size: 1.05rem;
  }

  .home-intro .institution {
    font-size: 0.95rem;
  }

  .home-intro .research {
    font-size: 1rem;
    line-height: 1.65;
  }

  .social-links {
    margin-top: 1.7rem;
  }
}

/* ---------- Blog page ---------- */

.blog-page {
  max-width: 900px;
  margin: 0 auto;
}


/* ---------- Blog title ---------- */

#title-block-header {
  max-width: 900px;
  margin: 4.5rem auto 2.5rem auto;
  padding-left: 2rem;
  padding-right: 2rem;
}

#title-block-header .title {
  color: $text-main;
  font-family: "Charter", Georgia, serif;
  font-size: 2.5rem;
  font-weight: 500;
  letter-spacing: -0.02em;
  margin-bottom: 0;
}


/* ---------- Listing container ---------- */

.quarto-listing {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem 4rem 2rem;
}


/* ---------- Individual posts ---------- */

.quarto-post {
  border-bottom: 1px solid $border-color !important;
  padding: 2rem 0 !important;
  margin: 0 !important;
}

.quarto-post:first-child {
  padding-top: 0 !important;
}


/* ---------- Post image ---------- */

.quarto-post .thumbnail {
  border-radius: 4px;
  overflow: hidden;
}

.quarto-post .thumbnail img {
  width: 100%;
  height: 150px;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.quarto-post:hover .thumbnail img {
  transform: scale(1.02);
}


/* ---------- Post title ---------- */

.quarto-post .listing-title {
  color: $text-main !important;
  font-family: "Charter", Georgia, serif;
  font-size: 1.45rem;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: -0.01em;
  margin-bottom: 0.5rem;
}

.quarto-post .listing-title a {
  color: inherit !important;
}

.quarto-post .listing-title a:hover {
  color: $accent-color !important;
}


/* ---------- Date ---------- */

.quarto-post .listing-date {
  color: $text-muted !important;
  font-family: "Charter", Georgia, serif;
  font-size: 0.85rem;
  letter-spacing: 0.04em;
}


/* ---------- Description ---------- */

.quarto-post .listing-description {
  color: $text-muted !important;
  font-size: 0.98rem;
  line-height: 1.65;
  margin-top: 0.6rem;
}


/* ---------- Read more / links ---------- */

.quarto-post a {
  text-decoration: none;
}


/* ---------- Mobile ---------- */

@media (max-width: 768px) {

  #title-block-header {
    margin-top: 3rem;
    margin-bottom: 2rem;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  #title-block-header .title {
    font-size: 2rem;
  }

  .quarto-listing {
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    padding-bottom: 3rem;
  }

  .quarto-post {
    padding: 1.6rem 0 !important;
  }

  .quarto-post .listing-title {
    font-size: 1.25rem;
  }

  .quarto-post .listing-description {
    font-size: 0.95rem;
  }

  .quarto-post .thumbnail img {
    height: 130px;
  }
}