/*-- scss:defaults --*/

/* ---------- Palette ---------- */

$paper-bg: #F3F6F8;
$text-main: #252C33;
$text-muted: #687681;
$accent-color: #416B82;
$accent-dark: #294E63;
$border-color: #D8E1E7;


/*-- scss:rules --*/

/* ---------- Global ---------- */

body {
  background-color: $paper-bg;
  color: $text-main;
  font-family: "Charter", Georgia, serif;
  font-size: 17px;
  line-height: 1.7;
}

main {
  background-color: $paper-bg;
}

a {
  color: $accent-color;
  text-decoration: none;
}

a:hover {
  color: $text-main;
}


/* ---------- Navbar ---------- */

.navbar {
  background-color: $paper-bg !important;
  border-bottom: 1px solid $border-color;
  box-shadow: none !important;
  padding-top: 0.85rem;
  padding-bottom: 0.85rem;
}

/* Center the entire navbar content */
.navbar .container-fluid,
.navbar .container {
  justify-content: center !important;
}

/* Site name */
.navbar-brand {
  display: block !important;
  color: $accent-dark !important;
  font-family: "Charter", Georgia, serif;
  font-size: 1.05rem;
  font-weight: 500;
  margin-right: 1.5rem;
}

/* Navigation */
.navbar-collapse {
  flex-grow: 0 !important;
}

.navbar-nav {
  justify-content: center !important;
  align-items: center;
}

.navbar-nav .nav-link {
  color: $accent-dark !important;
  font-family: "Charter", Georgia, serif;
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-transform: none;
  padding-left: 1rem;
  padding-right: 1rem;
}

.navbar-nav .nav-link:hover,
.navbar-nav .nav-link.active {
  color: #183B50 !important;
}


/* ---------- Homepage container ---------- */

#quarto-content {
  max-width: 900px;
  margin: 0 auto;
  padding-left: 2rem;
  padding-right: 2rem;
}


/* ---------- Homepage introduction ---------- */

.home-intro {
  max-width: 760px;
  margin: 5rem auto 0 auto;
  text-align: center;
}


/* ---------- Portrait ---------- */

.home-intro img {
  width: 165px;
  height: 165px;
  object-fit: cover;
  border-radius: 50%;
  display: block;
  margin: 0 auto 2rem auto;
}


/* ---------- Name ---------- */

.home-intro h1 {
  color: $text-main;
  font-family: "Charter", Georgia, serif;
  font-size: 2.45rem;
  font-weight: 500;
  line-height: 1.2;
  margin: 0 0 0.75rem 0;
}


/* ---------- Academic position ---------- */

.home-intro .position {
  color: $accent-color;
  font-size: 1.15rem;
  line-height: 1.5;
  margin: 0 auto 0.35rem auto;
  font-weight: 500;
}


/* ---------- Institution ---------- */

.home-intro .institution {
  font-size: 1rem;
  line-height: 1.5;
  margin: 0 auto 1.8rem auto;
}

.home-intro .institution a {
  color: #1769A3 !important;
  text-decoration: none !important;
}

.home-intro .institution a:hover {
  color: #0D4F7C !important;
  text-decoration: underline !important;
}


/* ---------- Research statement ---------- */

.home-intro .research {
  max-width: 680px;
  margin: 0 auto;
  color: $text-main;
  font-size: 1.05rem;
  line-height: 1.75;
}


/* ---------- Social links ---------- */

.social-links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1.15rem;
  margin-top: 2rem;
}

.social-links a {
  color: $text-muted;
  transition: color 0.2s ease;
}

.social-links a:hover {
  color: $accent-color;
}

.social-links svg {
  width: 20px;
  height: 20px;
  fill: currentColor;
}


/* ---------- General headings ---------- */

h1,
h2,
h3,
h4 {
  color: $text-main;
  font-family: "Charter", Georgia, serif;
  font-weight: 500;
}

h2 {
  margin-top: 3.5rem;
  margin-bottom: 1.25rem;
  font-size: 1.7rem;
}

h3 {
  font-size: 1.35rem;
}


/* ---------- General text ---------- */

p {
  color: $text-main;
}

.quarto-title-block {
  margin-bottom: 0;
}


 /* ---------- Footer ---------- */

#quarto-footer,
.nav-footer,
.page-footer {
  background: $paper-bg !important;
  background-color: $paper-bg !important;
  color: $text-muted !important;
  border: none !important;
  box-shadow: none !important;
}

#quarto-footer .container,
#quarto-footer .container-fluid,
.nav-footer .container,
.nav-footer .container-fluid {
  background: $paper-bg !important;
}

#quarto-footer p,
#quarto-footer a,
.nav-footer p,
.nav-footer a {
  color: $text-muted !important;
}

#quarto-footer a:hover,
.nav-footer a:hover {
  color: $accent-color !important;
}


/* ---------- Remove old process-flow graphics ---------- */

.process-flow,
.process-flow-container,
.process-image,
.process-images,
.ecology-process {
  display: none !important;
}


/* ---------- Mobile ---------- */

@media (max-width: 768px) {

  #quarto-content {
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .home-intro {
    margin-top: 3.5rem;
  }

  .home-intro img {
    width: 140px;
    height: 140px;
    margin-bottom: 1.6rem;
  }

  .home-intro h1 {
    font-size: 2rem;
  }

  .home-intro .position {
    font-size: 1.05rem;
  }

  .home-intro .institution {
    font-size: 0.95rem;
  }

  .home-intro .research {
    font-size: 1rem;
    line-height: 1.65;
  }

  .social-links {
    margin-top: 1.7rem;
  }
}


/* =========================================================
   BLOG PAGE
   ========================================================= */

/* ---------------------------------------------------------
   BREAK QUARTO'S DEFAULT CONTENT GRID (same fix as Publications)
   --------------------------------------------------------- */

body:has(.quarto-listing) .page-columns {
  display: block !important;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

body:has(.quarto-listing) #quarto-content {
  display: block !important;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

body:has(.quarto-listing) main.content {
  display: block !important;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* ---------- Page container ---------- */

.blog-page {
  max-width: 1150px;
  width: 74vw;
  margin: 0 auto;
  box-sizing: border-box;
}

.quarto-listing {
  max-width: 1150px;
  width: 74vw;
  margin: 0 auto;
  padding: 0 0 4rem 0;
  box-sizing: border-box;
  overflow: visible;
}

/* ---------- Blog title ---------- */

body:has(.quarto-listing) #title-block-header {
  display: block !important;
  max-width: 1150px !important;
  width: 74vw !important;
  margin: 4rem auto 2.5rem auto !important;
  padding: 0 !important;
  box-sizing: border-box;
  text-align: center;
}

#title-block-header .title {
  color: $text-main;
  font-family: "Charter", Georgia, serif;
  font-size: 2.5rem;
  font-weight: 500;
  letter-spacing: -0.02em;
  margin-bottom: 0;
}

/* ---------- Fix Bootstrap row overflow ---------- */

.quarto-listing .row {
  margin-left: 0 !important;
  margin-right: 0 !important;
  --bs-gutter-x: 1.75rem !important;
  row-gap: 1.75rem;
}

.quarto-listing .row > * {
  padding-left: 0 !important;
  padding-right: calc(var(--bs-gutter-x) / 2) !important;
}

.quarto-listing .row > *:nth-child(3n) {
  padding-right: 0 !important;
}

/* ---------- Grid cards ---------- */

.quarto-grid-item {
  background: #ffffff;
  border-radius: 6px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  border: none !important;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.quarto-grid-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
}

.quarto-grid-item .thumbnail-image,
.quarto-grid-item img {
  width: 100%;
  height: 150px;
  object-fit: cover;
  display: block;
}

.quarto-grid-item .card-body,
.quarto-grid-item .listing-item-content {
  padding: 1.1rem 1.3rem 1.4rem 1.3rem !important;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ---------- Post title ---------- */

.quarto-grid-item .listing-title {
  color: $text-main !important;
  font-family: "Charter", Georgia, serif;
  font-size: 1.15rem;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: -0.01em;
  margin-bottom: 0.4rem;
}

.quarto-grid-item .listing-title a {
  color: inherit !important;
  text-decoration: none;
}

.quarto-grid-item .listing-title a:hover {
  color: $accent-color !important;
}

/* ---------- Date ---------- */

.quarto-grid-item .listing-date {
  color: $text-muted !important;
  font-family: "Charter", Georgia, serif;
  font-size: 0.78rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
  display: block;
  order: -1;
}

/* ---------- Description ---------- */

.quarto-grid-item .listing-description {
  color: $text-muted !important;
  font-size: 0.88rem;
  line-height: 1.55;
}

/* ---------- Tablet ---------- */

@media (max-width: 900px) {

  .blog-page,
  .quarto-listing,
  body:has(.quarto-listing) #title-block-header {
    width: 90vw !important;
  }

  .quarto-listing .row > *:nth-child(3n) {
    padding-right: calc(var(--bs-gutter-x) / 2) !important;
  }

  .quarto-listing .row > *:nth-child(2n) {
    padding-right: 0 !important;
  }
}

/* ---------- Mobile ---------- */

@media (max-width: 768px) {

  body:has(.quarto-listing) #title-block-header {
    margin-top: 3rem !important;
    margin-bottom: 2rem !important;
  }

  #title-block-header .title {
    font-size: 2rem;
  }

  .quarto-listing {
    padding-bottom: 3rem;
  }

  .quarto-grid-item .thumbnail-image,
  .quarto-grid-item img {
    height: 140px;
  }
}

/* =========================================================
   PUBLICATIONS
   ========================================================= */


/* ---------------------------------------------------------
   BREAK QUARTO'S DEFAULT CONTENT GRID
   --------------------------------------------------------- */

body:has(.publication-grid) .page-columns {
  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;
}


body:has(.publication-grid) #quarto-content {
  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;
}


body:has(.publication-grid) main.content {
  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* ---------------------------------------------------------
   TITLE
   --------------------------------------------------------- */

body:has(.publication-grid) #title-block-header {
  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 4rem 0 0 0 !important;

  box-sizing: border-box;

  text-align: center;
}


/* ---------------------------------------------------------
   PUBLICATION WRAPPER
   --------------------------------------------------------- */

.publication-wrapper {
  display: block !important;

  width: 76vw !important;
  max-width: 1200px !important;

  margin: 4rem auto !important;
  padding: 0 !important;

  box-sizing: border-box;
}


/* ---------------------------------------------------------
   PUBLICATION GRID
   --------------------------------------------------------- */

.publication-grid {
  display: flex !important;

  flex-direction: row !important;
  flex-wrap: wrap !important;

  justify-content: flex-start !important;
  align-items: stretch !important;

  direction: ltr !important;

  width: 100% !important;
  max-width: none !important;

  gap: 1.5rem !important;

  margin: 0 !important;
  padding: 0 !important;

  box-sizing: border-box;
}


/* ---------------------------------------------------------
   PUBLICATION CARDS
   --------------------------------------------------------- */

.publication-grid > a.publication-card {
  display: flex !important;

  flex-direction: column !important;

  flex: 0 0 calc(50% - 0.75rem) !important;

  width: calc(50% - 0.75rem) !important;
  max-width: calc(50% - 0.75rem) !important;
  min-width: 0 !important;

  height: 190px !important;

  box-sizing: border-box;

  margin: 0 !important;
  padding: 1.8rem 2.2rem !important;

  background: #ffffff;

  border: none;
  border-radius: 0;

  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);

  align-items: center !important;
  justify-content: center !important;

  text-decoration: none !important;
  color: inherit !important;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}


/* ---------------------------------------------------------
   HOVER
   --------------------------------------------------------- */

.publication-grid > a.publication-card:hover {
  transform: translateY(-3px);

  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.10);

  text-decoration: none !important;
}


/* ---------------------------------------------------------
   CARD TITLE
   --------------------------------------------------------- */

.publication-card h3 {
  font-size: 1.15rem;

  line-height: 1.35;

  margin: 0 0 0.9rem 0;

  text-align: center;
}


/* ---------------------------------------------------------
   CARD TEXT
   --------------------------------------------------------- */

.publication-card p {
  font-size: 0.9rem;

  line-height: 1.4;

  margin: 0.15rem 0;

  text-align: center;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .publication-wrapper {
    width: 90vw !important;
  }

  .publication-grid {
    flex-direction: column !important;
    gap: 1.25rem !important;
  }

  .publication-grid > a.publication-card {
    flex: 0 0 100% !important;

    width: 100% !important;
    max-width: 100% !important;

    height: auto !important;
    min-height: 180px;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .publication-wrapper {
    width: 92vw !important;
  }

  .publication-grid {
    gap: 1rem !important;
  }

  .publication-grid > a.publication-card {
    padding: 1.5rem !important;
  }

  .publication-card h3 {
    font-size: 1.05rem;
  }

}

/* =========================================================
   CONTACT PAGE
   ========================================================= */

.contact-page {
  max-width: 700px;
  margin: 4rem auto;
  text-align: center;
}

.contact-page h1 {
  color: $text-main;
  font-family: "Charter", Georgia, serif;
  font-size: 2.5rem;
  font-weight: 500;
  letter-spacing: -0.02em;
  margin-bottom: 1.5rem;
}

.contact-page p {
  font-size: 1.05rem;
  line-height: 1.75;
  color: $text-main;
}

.contact-page a {
  color: $accent-color;
}

.contact-page a:hover {
  color: $text-main;
}

.contact-photo {
  display: block;
  margin: 3rem auto 0 auto;
  width: 100%;
  max-width: 500px;
  border-radius: 6px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

/* ---------- Mobile ---------- */

@media (max-width: 768px) {

  .contact-page {
    margin: 3rem auto;
    padding: 0 1.25rem;
  }

  .contact-page h1 {
    font-size: 2rem;
  }

  .contact-photo {
    margin-top: 2rem;
  }
}